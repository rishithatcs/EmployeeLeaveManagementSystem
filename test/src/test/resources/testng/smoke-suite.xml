<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    ELMS Smoke Test Suite
    Runs only @Test(groups={"smoke"}) tests.
    Fast sanity check: login works, key endpoints respond, key UI pages load.
    Use: mvn test -P smoke
-->
<suite name="ELMS Smoke Suite" parallel="none" verbose="2">

    <test name="Smoke - Auth API">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.elsm.automation.api.tests.AuthApiTest"/>
        </classes>
    </test>

    <test name="Smoke - Employee API">
        <groups>
            <run>
                <include name="smoke"/>
